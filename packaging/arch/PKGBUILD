# Builds mx from the committed HEAD of this checkout: cd packaging/arch && makepkg -si
# The AUR package mx-mail-bin installs the same files from a release and conflicts with this one.
pkgname=mx-mail
pkgver=0.1.0
pkgrel=1
pkgdesc='A local copy of a Microsoft 365 mailbox, served to AI agents over MCP'
arch=('x86_64')
license=('MIT')
# What the binary links, as ldd shows it: Arch's Bun runtime uses the system ICU.
depends=('glibc' 'icu' 'libgcc' 'libstdc++')
makedepends=('bun' 'git')
optdepends=('cloudflared: Graph push notifications; without it, mx downloads its own')
# Stripping a Bun executable cuts off the program it carries.
options=('!strip' '!debug')
# pacman can't reach users' home folders, so removal only says what is left there.
install="$pkgname.install"
source=("mx::git+file://${startdir%/packaging/arch}")
sha256sums=('SKIP')

pkgver() {
	cd mx
	sed -n 's/^\t"version": "\(.*\)",$/\1/p' package.json
}

build() {
	cd mx
	bun install --frozen-lockfile --production --ignore-scripts
	bun run build linux-x64
}

package() {
	cd mx
	install -Dm755 dist/mx-linux-x64 "$pkgdir/usr/bin/mx"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	install -Dm644 dist/THIRD_PARTY_NOTICES "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY_NOTICES"
	install -Dm644 dist/mx-sync.service "$pkgdir/usr/lib/systemd/user/mx-sync.service"
}
